                                                      Max="{Binding  Plugoftimes_Max, Mode=OneWay}"
                                                      Min="{Binding  Plugoftimes_Min, Mode=OneWay}"
                                                      Text="{Binding RC1_Plugoftimes, Mode=TwoWay}" />
                            </views:SpinControl>
                        </Border>
                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Background="{StaticResource WindowBackgroundBrush2}"
                                BorderThickness="1,0,1,1"
                                Style="{StaticResource ValueBorder}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="塗佈壓力設定" />
                        </Border>
                        <Border Grid.Row="1"
                                Grid.Column="3"
                                BorderThickness="0,0,1,1"
                                Style="{StaticResource ValueBorder}">
                            <views:SpinControl Maximum="{Binding CoatingPressureSetting_Max, Mode=OneWay}"
                                               Minimum="{Binding CoatingPressureSetting_Min, Mode=OneWay}"
                                               Value="{Binding RC1_CoatingPressureSetting, Mode=TwoWay}">
                                <views:SpinControl.SmallChange>
                                    <system:Double>1</system:Double>
                                </views:SpinControl.SmallChange>
                                <views:NumericTextBox BorderThickness="0"
