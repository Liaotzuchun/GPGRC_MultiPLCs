                                                      Min="{Binding  CoatingPressureSetting_Min, Mode=OneWay}"
                                                      Text="{Binding RC1_CoatingPressureSetting, Mode=TwoWay}" />
                            </views:SpinControl>
                        </Border>
                        <Border Grid.Row="1"
                                Grid.Column="4"
                                Background="{StaticResource WindowBackgroundBrush2}"
