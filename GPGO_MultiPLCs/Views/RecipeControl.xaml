<UserControl x:Class="GPGRC_MultiPLCs.Views.RecipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:GPGRC_MultiPLCs.Models"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:views="clr-namespace:GPMVVM.Views;assembly=GPMVVM"
             xmlns:vm="clr-namespace:GPGRC_MultiPLCs.ViewModels"
             d:DataContext="{d:DesignInstance vm:RecipeControl_ViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1024"
             Foreground="{StaticResource BaseForeground}"
             Loaded="UserControl_Loaded"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Margin="0,0,4,0"
              Background="{StaticResource WindowBackgroundBrush6}"
              IsEnabled="{Binding User.Level, Source={StaticResource Mediator}, Converter={StaticResource IsMoreThanValue}, ConverterParameter=2, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height = "*"/>
                <RowDefinition Height = "*"/>
                <RowDefinition Height = "1.5*"/>
            </Grid.RowDefinitions>
                <GroupBox Grid.Row="0"
                          Header="Coater1">
                    <Grid Background="{StaticResource WindowBackgroundBrush6}"
                          ClipToBounds="True"
                          DataContext="{Binding SelectedRecipe, Mode=OneWay}"
                          IsEnabled="{Binding Converter={StaticResource IsNotNull}, Mode=OneWay}"
                          TextElement.FontSize="14"
                          TextElement.FontWeight="Bold">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Background="{StaticResource WindowBackgroundBrush2}"
                                BorderThickness="1,0,1,1"
                                Style="{StaticResource ValueBorder}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="塗佈次數" />
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                BorderThickness="0,0,1,1"
                                Style="{StaticResource ValueBorder}">
                            <views:SpinControl Maximum="{Binding Coatingoftimes_Max, Mode=OneWay}"
                                               Minimum="{Binding Coatingoftimes_Min, Mode=OneWay}"
                                               Value="{Binding RC1_Coatingoftimes, Mode=TwoWay}">
                                <views:SpinControl.SmallChange>
                                    <system:Double>1</system:Double>
                                </views:SpinControl.SmallChange>
                                <views:NumericTextBox BorderThickness="0"
                                                      IntOnly="True"
                                                      Max="{Binding  Coatingoftimes_Max, Mode=OneWay}"
                                                      Min="{Binding  Coatingoftimes_Min, Mode=OneWay}"
                                                      Text="{Binding RC1_Coatingoftimes, Mode=TwoWay}" />
                            </views:SpinControl>
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Background="{StaticResource WindowBackgroundBrush2}"
                                BorderThickness="1,0,1,1"
                                Style="{StaticResource ValueBorder}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="塗佈速度設定" />
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="3"
                                BorderThickness="0,0,1,1"
                                Style="{StaticResource ValueBorder}">
                            <views:SpinControl Maximum="{Binding CoatingSpeedSetting_Max, Mode=OneWay}"
                                               Minimum="{Binding CoatingSpeedSetting_Min, Mode=OneWay}"
                                               Value="{Binding RC1_CoatingSpeedSetting, Mode=TwoWay}">
                                <views:SpinControl.SmallChange>
                                    <system:Double>1</system:Double>
                                </views:SpinControl.SmallChange>
                                <views:NumericTextBox BorderThickness="0"
                                                      IntOnly="True"
                                                      Max="{Binding CoatingSpeedSetting_Max, Mode=OneWay}"
                                                      Min="{Binding CoatingSpeedSetting_Min, Mode=OneWay}"
                                                      Text="{Binding RC1_CoatingSpeedSetting, Mode=TwoWay}" />
                            </views:SpinControl>
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="4"
                                Background="{StaticResource WindowBackgroundBrush2}"
                                BorderThickness="1,0,1,1"
                                Style="{StaticResource ValueBorder}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="板面夾持距離" />
                        </Border>
                        <Border Grid.Row="0"
